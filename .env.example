APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_NAME=Calendar
DEFAULT_TIMEZONE=UTC

HTTP_ADDR=:8080
HTTP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY=1MB

DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_AUTO_MIGRATE=true

TEST_DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar_test?sslmode=disable

SECRET_KEYS=
SECRET_KEY_ACTIVE=
SESSION_TTL=720h
SESSION_ABSOLUTE_TTL=2160h
COOKIE_SECURE=false
PASSWORD_MIN_LENGTH=10

REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_DOMAINS=
REGISTRATION_PASSWORD_ENABLED=true
REGISTRATION_GOOGLE_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SYNC_ENABLED=true
GOOGLE_WEBHOOKS_ENABLED=true
GOOGLE_POLL_INTERVAL=5m

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

WEBPUSH_VAPID_PUBLIC=
WEBPUSH_VAPID_PRIVATE=
WEBPUSH_VAPID_SUBJECT=

RATE_LIMIT_LOGIN=10/15m
RATE_LIMIT_API=600/1m
RATE_LIMIT_SHARE=120/1m

IMPORT_MAX_SIZE=20MB
IMPORT_MAX_ITEMS=50000

URL_FETCH_TIMEOUT=15s
URL_FETCH_MAX_REDIRECTS=3
URL_FETCH_ALLOW_PRIVATE=false

OUTBOUND_PROXY=
OUTBOUND_PROXY_FOR=google,push,sentry
OUTBOUND_NO_PROXY=

SUBSCRIPTION_DEFAULT_INTERVAL=1h
SUBSCRIPTION_MIN_INTERVAL=15m

RECURRENCE_MAX_INSTANCES=5000
SEARCH_MAX_RESULTS=200

OG_CACHE_DIR=./data/og
OG_CACHE_MAX=2GB

TRASH_RETENTION=720h
CHANGES_RETENTION=168h
AUDIT_RETENTION=8760h

WORKER_ENABLED=true
WORKER_CONCURRENCY=4

LOG_LEVEL=debug
LOG_FORMAT=auto
LOG_COLOR=auto

METRICS_ADDR=127.0.0.1:9091
METRICS_TOKEN=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0