# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_IDS=123456789

# Generate with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
STATE_ENCRYPTION_KEY=replace_with_fernet_key

# Storage. STATE_FILE/WORK_DIR/CODEX_DIR default under DATA_DIR unless explicitly set.
DATA_DIR=/data
# Ephemeral request capabilities. Keep outside DATA_DIR and do not persist this path.
CAP_DIR=/run/calendar-codex-bot/caps

# ACalendar
CALENDAR_MCP_URL=https://calendar.akarpov.ru/api/mcp
TOOL_CACHE_TTL_SECONDS=300

# Locale / scheduling
DEFAULT_TIMEZONE=Europe/Vilnius
POLL_INTERVAL_SECONDS=60
AGENDA_HOUR=8

# Codex. Leave model empty to use the subscription/default model.
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
REQUEST_TIMEOUT_SECONDS=300
ASK_TIMEOUT_SECONDS=600
DEVICE_LOGIN_TIMEOUT_SECONDS=900
# Must be greater than both ASK_TIMEOUT_SECONDS and REQUEST_TIMEOUT_SECONDS.
CAPABILITY_TTL_SECONDS=900
MAX_FILE_BYTES=20971520
MAX_HISTORY_ITEMS=50

# Optional proxies. Use e.g. http://user:pass@host:port or socks5://...
TELEGRAM_PROXY=
CALENDAR_PROXY=
CODEX_HTTP_PROXY=
CODEX_HTTPS_PROXY=
CODEX_ALL_PROXY=
NO_PROXY=127.0.0.1,localhost

# Internal guard (keep loopback-only)
GUARD_HOST=127.0.0.1
GUARD_PORT=8765
