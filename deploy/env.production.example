# Production template for calendar.akarpov.ru. Copy to .env beside
# docker-compose.yml and fill every <...> before the first boot.
#
# docker-compose.yml sets DATABASE_URL, HTTP_TRUSTED_PROXIES, METRICS_ADDR and
# WORKER_ENABLED per service, and those win over this file. Leave them out here.

# Read by docker-compose.yml, not by the app: it sets the database password for
# both the db container and the DATABASE_URL the app and worker connect with.
POSTGRES_PASSWORD=<database password>

# Host ports, bound to 127.0.0.1 only, for nginx to proxy to. Defaults are 8080
# and 9091; both are already taken on a host running other services, so check
# with `ss -ltn` and pick free ones. These name the host side only, the app
# still listens on 8080 inside the container.
APP_HOST_PORT=8090
METRICS_HOST_PORT=9191

APP_ENV=production
APP_BASE_URL=https://calendar.akarpov.ru
APP_NAME=Calendar
DEFAULT_TIMEZONE=Europe/Moscow

# Behind nginx the app still listens on plain HTTP inside the network.
HTTP_ADDR=:8080

# calendar keys generate
SECRET_KEYS=<1:base64key>
SECRET_KEY_ACTIVE=1

# The app is served over TLS, so the session cookie must be Secure and __Host-.
COOKIE_SECURE=true
PASSWORD_MIN_LENGTH=10

REGISTRATION_ENABLED=true
REGISTRATION_PASSWORD_ENABLED=true
REGISTRATION_GOOGLE_ENABLED=true
# Restrict who can sign up, for example: REGISTRATION_ALLOWED_DOMAINS=akarpov.ru
REGISTRATION_ALLOWED_DOMAINS=

# Redirect URI in the Google console must be exactly:
#   https://calendar.akarpov.ru/auth/google/callback
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_SYNC_ENABLED=true
GOOGLE_WEBHOOKS_ENABLED=true
GOOGLE_POLL_INTERVAL=5m

# Without SMTP there is no email verification and no password reset, and
# registration silently marks every address as already verified.
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<smtp user>
SMTP_PASSWORD=<smtp password>
SMTP_FROM=Calendar <calendar@akarpov.ru>
SMTP_TLS=starttls

# calendar vapid generate
WEBPUSH_VAPID_PUBLIC=<vapid public>
WEBPUSH_VAPID_PRIVATE=<vapid private>
WEBPUSH_VAPID_SUBJECT=mailto:calendar@akarpov.ru

RATE_LIMIT_LOGIN=10/15m
RATE_LIMIT_API=600/1m
RATE_LIMIT_SHARE=120/1m

IMPORT_MAX_SIZE=20MB
IMPORT_MAX_ITEMS=50000

URL_FETCH_TIMEOUT=15s
URL_FETCH_MAX_REDIRECTS=3
# Keep false: true lets a subscription URL reach services inside the network.
URL_FETCH_ALLOW_PRIVATE=false

SUBSCRIPTION_DEFAULT_INTERVAL=1h
SUBSCRIPTION_MIN_INTERVAL=15m

# Shares by the appdata volume, swept hourly back under the limit.
OG_CACHE_DIR=/data/og
OG_CACHE_MAX=2GB

TRASH_RETENTION=720h
CHANGES_RETENTION=168h
AUDIT_RETENTION=8760h

WORKER_CONCURRENCY=4

LOG_LEVEL=info
LOG_FORMAT=json

# openssl rand -hex 24
METRICS_TOKEN=<metrics token>

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
